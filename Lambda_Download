import { DynamoDBClient } from "@aws-sdk/client-dynamodb";
import { DynamoDBDocumentClient, GetCommand } from "@aws-sdk/lib-dynamodb";
import { S3Client, GetObjectCommand } from "@aws-sdk/client-s3";
import { getSignedUrl } from "@aws-sdk/s3-request-presigner";

const REGION = "ap-northeast-1";
const BUCKET_NAME = "company-s3-demo-upload";

const ddbClient = new DynamoDBClient({ region: REGION });
const dynamo = DynamoDBDocumentClient.from(ddbClient);

const s3 = new S3Client({ region: REGION });

const TABLE_NAME = "Documents";

export const handler = async (event) => {
try {
const body = JSON.parse(event.body || "{}");
const fileID = body.fileID;

console.log("=== REQUEST DEBUG ===");
console.log("fileID:", fileID);

if (!fileID) {
return {
statusCode: 400,
headers: {
"Access-Control-Allow-Origin": "*",
},
body: JSON.stringify({ message: "fileID is required" }),
};
}

// ① DynamoDBから取得
const result = await dynamo.send(
new GetCommand({
TableName: TABLE_NAME,
Key: {
fileID: fileID,
},
})
);

console.log("=== DYNAMODB RESULT ===");
console.log(JSON.stringify(result, null, 2));

if (!result.Item) {
  console.log("❌ Item not found in DynamoDB");

  return {
statusCode: 404,
headers: {
"Access-Control-Allow-Origin": "*",
},
body: JSON.stringify({ message: "File not found" }),
};
}

const item = result.Item;

console.log("=== ITEM ===");
console.log(JSON.stringify(item, null, 2));

if (!item.s3Key) {
  console.log("❌ s3Key is missing");

  return {
    statusCode: 500,
    headers: {
      "Access-Control-Allow-Origin": "*",
    },
    body: JSON.stringify({
      message: "s3Key is missing in DynamoDB item",
    }),
  };
}

// ② S3キー取得
const key = item.s3Key;

console.log("=== S3 KEY ===");
console.log(key);

// ③ 署名付きURL生成
const command = new GetObjectCommand({
Bucket: BUCKET_NAME,
Key: key,
});

const url = await getSignedUrl(s3, command, { expiresIn: 300 });

console.log("=== SIGNED URL GENERATED ===");

return {
statusCode: 200,
headers: {
"Access-Control-Allow-Origin": "*",
"Content-Type": "application/json",
},
body: JSON.stringify({ url }),
};
} catch (error) {
  console.log("=== FULL ERROR ===");
  console.log(JSON.stringify(error, null, 2));

return {
statusCode: 500,
headers: {
"Access-Control-Allow-Origin": "*",
},
body: JSON.stringify({ message: "Internal Server Error" }),
};
}
};
